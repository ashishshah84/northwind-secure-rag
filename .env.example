# Copy to .env and fill in. .env is gitignored - never commit a real key.

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LLM backend ---
# openrouter = real model calls (required for anything you put in the report)
# stub       = offline, deterministic fake model for exercising the pipeline
#              without a key/network. See app/llm.py docstring - not evidence.
LLM_BACKEND=openrouter

# --- Embeddings ---
# minilm  = real semantic embeddings (all-MiniLM-L6-v2 via chromadb, downloads ~80MB once)
# hashed  = offline deterministic bag-of-words fallback, for CI / no-network testing
EMBEDDING_BACKEND=minilm

# --- Vector store ---
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=northwind

# --- Security posture ---
# vulnerable = no retrieval filtering, no prompt separation, no output validation
# secure     = all mitigations on
SECURITY_MODE=vulnerable

# --- Trials ---
# How many times to repeat each attack case. Model behaviour under attack is not
# deterministic: across four single-shot runs, the same injection complied 3
# times out of 4 at temperature 0.2. Use 1 for quick iteration, 10 when
# collecting evidence for the report. A 10-trial full run is ~80 API calls,
# against a 50/day free tier - run attacks individually if that's a problem.
TRIALS=1
